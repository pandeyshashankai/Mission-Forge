import fs from "fs";
import { runAutopilotFlight } from "../flight";
import { presetLunarOrbiter, presetCrewedFlyby } from "../presets";
import { getMission } from "../missions";
import { DEFAULT_PROFILE } from "../guidance";
import { planTLI, planMCC, planCorridor } from "../transfer";
const prof = { ...DEFAULT_PROFILE, targetAltitude: 185000, targetInclination: 28.6 };
const ck = (id, label, m, design, sim) => ({ id, label, auto: false, at: new Date().toISOString(), missionId: m.id, missionName: m.name, difficulty: "amateur", design: sim.design, designName: design.name, profile: prof, simT: sim.t, state: sim.serialize() });
test("gen", () => {
  const out = [];
  const mo = getMission("lunar_orbiter"); const d1 = presetLunarOrbiter();
  const a = runAutopilotFlight(d1, mo, prof); a.attMode = "prograde";
  out.push(ck("lo_parking", "TEST parking orbit", mo, d1, a));
  const run = (s) => (c, max) => { const t0 = s.t; while (!c() && s.t - t0 < max && !s.isEnded()) s.advance(50, 1e6); };
  a.planManeuver(planTLI(a, { periAlt: 1e5 }).node); run(a)(() => a.maneuver.done, 2e4); run(a)(() => false, 7200);
  a.planManeuver(planMCC(a, { periAlt: 1e5 }).node); run(a)(() => a.maneuver.done, 2e4);
  run(a)(() => a.region === "moon", 7 * 86400); run(a)(() => false, 3600);
  out.push(ck("lo_moon", "TEST in Moon SOI before LOI", mo, d1, a));
  const mc = getMission("crewed_lunar_flyby"); const d2 = presetCrewedFlyby();
  const b = runAutopilotFlight(d2, mc, prof); b.attMode = "prograde";
  out.push(ck("cf_parking", "TEST crewed parking orbit", mc, d2, b));
  b.planManeuver(planTLI(b, { periAlt: 7e6, apogeeFactor: 1.14 }).node); run(b)(() => b.maneuver.done, 2e4); b.stage(); run(b)(() => false, 7200);
  b.planManeuver(planMCC(b, { periAlt: 7e6, freeReturn: true }).node); run(b)(() => b.maneuver.done, 2e4);
  run(b)(() => b.region === "moon", 7 * 86400); run(b)(() => b.region === "earth", 3 * 86400);
  b.planManeuver(planCorridor(b, 40000, 3600)); run(b)(() => b.maneuver.done, 2e4);
  run(b)(() => b.nav.alt < 30000000, 12 * 86400);
  out.push(ck("cf_return", "TEST crewed return 30,000 km out", mc, d2, b));
  fs.writeFileSync("public/ck_lunar.json", JSON.stringify(out));
}, 300000);
